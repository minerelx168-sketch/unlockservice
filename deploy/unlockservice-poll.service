[Unit]
Description=Ask the supplier about unlock orders and IMEI checks still in flight
After=unlockservice.service
# Nothing to poll if the app never came up; the timer simply skips this run.
Requisite=unlockservice.service

[Service]
Type=oneshot
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/unlockservice
Environment=NODE_ENV=production
Environment=IUNLOCKMOBILE_DB=/home/ubuntu/apps/unlockservice/data/iunlockmobile.db
# The same file the app reads. Without a supplier configured in it,
# pollProviderJobs() returns immediately and this run does nothing at all —
# which is why the timer is safe to leave enabled before the provider is.
EnvironmentFile=-/etc/iunlockmobile.env
ExecStart=/usr/local/bin/npm run provider:poll -- 40
# A supplier that is briefly unreachable is not an incident: the next run is
# two minutes away, and the ledger is unchanged either way.
SuccessExitStatus=0 1
TimeoutStartSec=120

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/home/ubuntu/apps/unlockservice/data
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
UMask=0077
