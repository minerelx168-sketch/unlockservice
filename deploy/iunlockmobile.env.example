# iUnlockMobile — service environment.
#
# Installed at /etc/iunlockmobile.env, owned by root, mode 0600, and read by
# the systemd unit. Nothing in here belongs in git: this file is the shape,
# with every secret left empty on purpose.
#
#   sudo install -m 600 -o root -g root \
#     deploy/iunlockmobile.env.example /etc/iunlockmobile.env
#   sudo nano /etc/iunlockmobile.env
#   sudo systemctl restart unlockservice
#
# deploy.sh installs this file with these defaults if it is not already
# there, so a fresh box comes up paused rather than open.

# ---- operating state --------------------------------------------------

# 1 pauses new orders. Existing orders are unaffected. Keep this on until a
# real supplier is configured and its prices have been checked.
IUNLOCKMOBILE_MAINTENANCE=1

# ---- supplier ---------------------------------------------------------
#
# disabled | enabled. While disabled the app will not place orders at all:
# it refuses rather than falling back to the demo supplier, which invents
# unlock codes. Turning this on needs the endpoint, the credentials and a
# service map that has been checked against the supplier's catalogue.
IUNLOCKMOBILE_PROVIDER_MODE=disabled
IUNLOCKMOBILE_PROVIDER_NAME=
IUNLOCKMOBILE_PROVIDER_URL=
IUNLOCKMOBILE_PROVIDER_USERNAME=
IUNLOCKMOBILE_PROVIDER_API_KEY=
IUNLOCKMOBILE_PROVIDER_DHRU_KEY=
IUNLOCKMOBILE_PROVIDER_TIMEOUT_MS=30000

# JSON maps from our catalogue key to the supplier's service id, e.g.
#   {"carrier:101":{"id":"1234","mode":"dhru"}}
#   {"check:basic":{"id":"77","mode":"sync"}}
IUNLOCKMOBILE_UNLOCK_SERVICE_MAP=
IUNLOCKMOBILE_IMEI_SERVICE_MAP=

# ---- privacy ----------------------------------------------------------
#
# Keys the fingerprint that stands in for a stored IMEI. At least 32
# characters, and generated once — changing it orphans every existing
# fingerprint. In production the checks refuse to run without it.
#   openssl rand -hex 32
IUNLOCKMOBILE_IMEI_FINGERPRINT_SECRET=

# ---- payment ----------------------------------------------------------
#
# The receiving wallet. With this unset no payment method is offered at
# all, which is the correct state until a small transfer has been sent and
# confirmed to arrive. Check it character by character: a wrong address
# sends customer funds somewhere unrecoverable. It must be a self-custody
# wallet, not an exchange deposit address — exchanges settle transfers
# between their own users off-chain, where the watcher cannot see them.
IUNLOCKMOBILE_USDT_BEP20_ADDRESS=
IUNLOCKMOBILE_USDT_FEE_BPS=0

# The payment watcher reads USDT transfers into that wallet off BNB Smart
# Chain and credits invoices by the code in their amount, so customers
# never paste a transaction id. It only reads; nothing here can move funds.
# The endpoint must serve eth_getLogs — the free bsc-dataseed nodes restrict
# it, so use a provider URL (NodeReal, Ankr, QuickNode, Chainstack …).
IUNLOCKMOBILE_BSC_RPC_URL=
# Blocks a transfer must be buried under before it counts (~10s on BSC).
IUNLOCKMOBILE_USDT_CONFIRMATIONS=15
# A coded transfer this short still credits in full — exchanges that take
# their withdrawal fee out of the amount. The smaller of the two applies.
# Either at 0 = credit only what arrives.
IUNLOCKMOBILE_USDT_SHORTFALL_TOLERANCE_CENTS=100
IUNLOCKMOBILE_USDT_SHORTFALL_TOLERANCE_BPS=300
# Optional: the block a fresh install starts reading from. Default ~1h back.
IUNLOCKMOBILE_USDT_SCAN_START_BLOCK=
# 0 turns off the in-server timer (scans still run while a customer waits).
IUNLOCKMOBILE_USDT_WATCH=1

# ---- email ------------------------------------------------------------
RESEND_API_KEY=
IUNLOCKMOBILE_EMAIL_FROM=
IUNLOCKMOBILE_EMAIL_REPLY_TO=
# 1 makes a new account prove its address before it can sign in. It also
# closes the path where a Google sign-in adopts an account that only
# asserted the address, so turn it on once email delivery works.
IUNLOCKMOBILE_REQUIRE_EMAIL_VERIFICATION=0

# ---- public address ---------------------------------------------------
#
# Used by robots.txt and the sitemap, which name absolute URLs and are not
# rendered per request, so there is no Host header to read. Falls back to
# the origin of GOOGLE_REDIRECT_URI, then to https://iunlockmobile.com.
IUNLOCKMOBILE_PUBLIC_ORIGIN=https://iunlockmobile.com

# ---- Google sign-in ---------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://iunlockmobile.com/auth/google/callback

# ---- switches that must stay off in production ------------------------
#
# Left here named rather than omitted, so that anyone reading this file can
# see they exist and that they are off. Setting either one on a box that
# takes real money is a mistake, not a shortcut.
#
#   IUNLOCKMOBILE_ALLOW_SELF_APPROVE=1   lets an account credit itself
#   IUNLOCKMOBILE_ALLOW_MOCK_SUPPLIER=1  serves invented unlock codes
