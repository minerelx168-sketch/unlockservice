[Unit]
Description=Unlockservice Next.js production application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/apps/unlockservice
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
Environment=IUNLOCKMOBILE_DB=/home/ubuntu/apps/unlockservice/data/iunlockmobile.db
# Everything else — the maintenance flag, the supplier, the fingerprint key,
# the wallet, the mail and OAuth credentials — is read from here. deploy.sh
# installs it with paused defaults on a first run.
#
# The leading dash tolerates it being missing, which is the right trade now
# that each dangerous switch fails closed on its own: with no file the
# supplier is disabled so orders are refused outright, no payment method is
# offered at all, self-approval is off, and IMEI checks refuse to run. A
# service that will not start is the worse failure, and it is the one an
# operator hits when the unit lands a moment before the file does.
EnvironmentFile=-/etc/iunlockmobile.env
ExecStart=/usr/local/bin/npm run start -- --hostname 127.0.0.1
Restart=always
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
# ProtectSystem stays at full and ProtectHome at false because the app, its
# build output and its database all live under /home/ubuntu.
ProtectSystem=full
ProtectHome=false
ReadWritePaths=/home/ubuntu/apps/unlockservice/data /home/ubuntu/apps/unlockservice/.next
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
